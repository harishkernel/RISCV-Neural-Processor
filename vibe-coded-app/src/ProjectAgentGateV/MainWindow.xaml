<Window x:Class="ProjectAgentGateV.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ProjectAgentGateV.Controls"
        Title="Project-AgentGate-V" Width="1260" Height="820" MinWidth="980" MinHeight="660"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="#FFFFFF" FontFamily="Segoe UI" Loaded="Window_Loaded" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Grid Background="#FFFFFF">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>

    <!-- Profile setup -->
    <Grid Grid.Row="0" x:Name="OnboardingView" Margin="54,36,54,34" Visibility="Collapsed">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,58,0">
        <TextBlock Text="Inference benchmark" FontSize="34" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
        <TextBlock Text="Let's see how much computation power your PC can sustain." FontSize="15" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,30,10"/>
        <Canvas x:Name="HeroMascotStage" Height="245" ClipToBounds="False" IsHitTestVisible="False">
          <local:AndGateMascot x:Name="GateMascot" Width="92" Height="92" Canvas.Left="4" Canvas.Top="110"/>
          <Border Canvas.Left="116" Canvas.Top="70" Background="#F8F7F5" BorderBrush="#E8E7E5" BorderThickness="1" CornerRadius="14" Padding="14,10" MaxWidth="220">
            <TextBlock x:Name="GateCaption" Text="Ready when your dataset is." Foreground="#555450" FontSize="13" TextWrapping="Wrap"/>
          </Border>
        </Canvas>
        <StackPanel Orientation="Horizontal" Margin="2,4,0,0">
          <Viewbox Width="14" Height="14" Margin="0,0,8,0"><Path Data="{StaticResource OcticonCpu}" Fill="{StaticResource MutedBrush}"/></Viewbox>
          <TextBlock Text="Private by architectural design." FontSize="12" Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>
      </StackPanel>

      <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="20" BorderBrush="#E8E7E5" BorderThickness="1" Padding="34" VerticalAlignment="Center" Effect="{StaticResource CardShadow}">
        <StackPanel>
          <TextBlock Text="Benchmark profile" FontSize="23" FontWeight="SemiBold"/>
          <TextBlock Text="Your details label each local report." FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,24"/>
          <Border Background="#F6F5F3" BorderBrush="#E8E7E5" BorderThickness="1" CornerRadius="11" Padding="12,10" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Viewbox Width="16" Height="16" Margin="0,0,10,0"><Path Data="{StaticResource OcticonCpu}" Fill="{StaticResource InkBrush}"/></Viewbox>
              <TextBlock Text="Engine: DeepVGG-Edge (19-Class)  ·  Embedded &amp; ready" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>

          <TextBlock Text="USERNAME" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,7"/>
          <TextBox x:Name="UsernameBox" Style="{StaticResource FieldInput}" MaxLength="48" ToolTip="Name included in your reports"/>

          <TextBlock Text="COUNTRY / REGION" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,18,0,7"/>
          <Grid><ComboBox x:Name="CountryCombo" Style="{StaticResource FieldCombo}" IsEditable="False" PreviewMouseLeftButtonDown="ProfileCombo_PreviewMouseLeftButtonDown" SelectionChanged="CountryCombo_SelectionChanged">
            <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><local:CountryFlagIcon FlagCode="{Binding Code}" Margin="0,0,10,0"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="13"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox><TextBlock x:Name="CountryPlaceholder" Text="Select country or region" Margin="12,0,40,0" VerticalAlignment="Center" Foreground="#92918E" IsHitTestVisible="False"/></Grid>

          <TextBlock Text="STRESS TEST TARGET" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,20,0,2"/>
          <TextBlock Text="Choose one or both compute engines for a comparison." FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,11"/>
          <CheckBox x:Name="CpuDeviceCheckBox" Style="{StaticResource DeviceCheckBox}" IsChecked="True" Content="CPU  ·  ONNX Runtime" Margin="0,0,0,10" Checked="DeviceSelection_Changed" Unchecked="DeviceSelection_Changed" AutomationProperties.Name="Include CPU inference in benchmark"/>
          <CheckBox x:Name="GpuDeviceCheckBox" Style="{StaticResource DeviceCheckBox}" IsChecked="False" Visibility="Collapsed" Content="GPU  ·  DirectML" Margin="0,0,0,8" Checked="DeviceSelection_Changed" Unchecked="DeviceSelection_Changed" AutomationProperties.Name="Include detected GPU with DirectML in benchmark"/>
          <TextBlock x:Name="GpuProviderNote" Text="Graphics hardware is checked when the app opens." FontSize="10" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="27,0,0,20"/>
          <Button Style="{StaticResource PrimaryButton}" Click="Continue_Click" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="Choose dataset" VerticalAlignment="Center"/><Viewbox Width="15" Height="15" Margin="10,0,0,0"><Path Data="{StaticResource OcticonArrowRight}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Viewbox></StackPanel>
          </Button>
        </StackPanel>
      </Border>
    </Grid>

    <!-- A dedicated, full-width dataset selection step. -->
    <Grid Grid.Row="0" x:Name="DatasetView" Margin="50,30,50,28" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="0,0,0,24">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button x:Name="BackToSetupButton" Style="{StaticResource SecondaryButton}" Width="42" Height="42" Padding="0" Click="BackToSetup_Click" VerticalAlignment="Center" ToolTip="Back to setup" AutomationProperties.Name="Back to setup">
          <Viewbox Width="17" Height="17"><Path Data="{StaticResource OcticonArrowLeft}" Fill="{StaticResource InkBrush}"/></Viewbox>
        </Button>
        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Target dataset" FontSize="24" FontWeight="SemiBold"/>
          <TextBlock Text="Choose the extracted test folder. We’ll check all 19 symbol classes before continuing." FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
        </StackPanel>
        <TextBlock Grid.Column="2" Text="STEP 02  /  03" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
      </Grid>

      <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E5E4E1" BorderThickness="1" CornerRadius="20" Padding="30" Effect="{StaticResource CardShadow}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Grid.Row="0">
            <TextBlock Text="Choose a test dataset" FontSize="19" FontWeight="SemiBold"/>
            <TextBlock Text="Select the extracted folder that contains the class folders directly inside it." FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
          </StackPanel>
          <Border Grid.Row="1" x:Name="DatasetDropZone" AllowDrop="True" Focusable="True" KeyboardNavigation.IsTabStop="True" DragEnter="DatasetDropZone_DragEnter" DragOver="DatasetDropZone_DragOver" DragLeave="DatasetDropZone_DragLeave" Drop="DatasetDropZone_Drop" PreviewMouseLeftButtonUp="DatasetDropZone_MouseLeftButtonUp" KeyDown="DatasetDropZone_KeyDown" Background="#FAF9F7" BorderBrush="#DCDAD6" BorderThickness="1" CornerRadius="16" Padding="24" Margin="0,20,0,16" Cursor="Hand" AutomationProperties.Name="Choose or drop test dataset folder">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <Border Width="52" Height="52" CornerRadius="15" Background="#F0EFED" HorizontalAlignment="Center" Margin="0,0,0,14"><Viewbox Width="23" Height="23" HorizontalAlignment="Center" VerticalAlignment="Center"><Path x:Name="DatasetZoneIcon" Data="{StaticResource OcticonFolder}" Fill="{StaticResource InkBrush}"/></Viewbox></Border>
              <TextBlock x:Name="DatasetDropHeadline" Text="Click to choose your test folder" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" TextAlignment="Center"/>
              <TextBlock x:Name="DatasetDropHint" Text="File Explorer opens here. You can also drag the folder onto this panel." FontSize="12" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,7,0,0"/>
              <TextBlock Text="Choose a folder, not individual images, an archive, or the ONNX model." FontSize="11" Foreground="#878580" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
          </Border>
          <StackPanel Grid.Row="2">
            <Border x:Name="DatasetPathPanel" Background="#F7F6F4" BorderBrush="#E8E7E5" BorderThickness="1" CornerRadius="10" Padding="13,11">
              <TextBlock x:Name="DatasetPathText" Text="No dataset folder selected" FontSize="13" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="Selected dataset path"/>
            </Border>
            <Border x:Name="DatasetStatusBadge" Background="#F3F2F0" CornerRadius="9" Padding="11,9" Margin="0,10,0,0" HorizontalAlignment="Left">
              <TextBlock x:Name="DatasetCountText" Text="Choose a test folder to scan its classes and images." FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
            </Border>
            <TextBlock Text="Required folders: (, ), +, -, 0–9, =, X, forward_slash, times, y  ·  Images: PNG, JPG/JPEG, BMP, GIF, TIF/TIFF" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="1,12,0,0"/>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="2" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="Your dataset stays on this PC. No files are uploaded." FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
        <Button x:Name="DatasetContinueButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Continue to benchmark" Click="DatasetContinue_Click" IsEnabled="False" MinWidth="220"/>
      </Grid>
    </Grid>

    <!-- Execution and report page. Hardware details are intentionally collapsed. -->
    <Grid Grid.Row="0" x:Name="DashboardView" Margin="34,22,34,16" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="2,0,2,17">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button x:Name="BackToDatasetButton" Style="{StaticResource SecondaryButton}" Width="42" Height="42" Padding="0" Click="BackToDataset_Click" VerticalAlignment="Center" ToolTip="Back to dataset" AutomationProperties.Name="Back to dataset">
          <Viewbox Width="17" Height="17"><Path Data="{StaticResource OcticonArrowLeft}" Fill="{StaticResource InkBrush}"/></Viewbox>
        </Button>
        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
          <TextBlock x:Name="WelcomeTitle" Text="Inference benchmark" FontSize="23" FontWeight="SemiBold"/>
          <TextBlock Text="Batch-one inference · local execution · measured frame latency" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
        </StackPanel>
        <Expander x:Name="SystemProfileExpander" Grid.Column="2" Header="System profile" IsExpanded="False" FontSize="12" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" MaxWidth="390">
          <Border Background="#FAF9F7" BorderBrush="#E8E7E5" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,8,0,0">
            <StackPanel>
              <TextBlock x:Name="ProfileStatusText" Text="Hardware profile is collected locally." FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
              <TextBlock x:Name="HardwareBriefText" Text="Windows, architecture, and storage summary." FontSize="11" Foreground="#555450" TextWrapping="Wrap" LineHeight="17"/>
              <ItemsControl x:Name="HardwareDetailsList" Margin="0,5,0,0">
                <ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#E9E8E5" BorderThickness="0,0,0,1" Padding="0,8"><StackPanel><TextBlock Text="{Binding Label}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Value}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/><TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </Expander>
      </Grid>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="0.82*"/><ColumnDefinition Width="1.18*"/></Grid.ColumnDefinitions>
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,10,0">
          <StackPanel>
            <Border Background="#FFFFFF" BorderBrush="#E5E4E1" BorderThickness="1" CornerRadius="17" Padding="19" Margin="0,0,0,12">
              <StackPanel>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Run inference" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="ModelStatusText" Text="The embedded ONNX engine loads when the test starts." FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel><Border Grid.Column="1" Background="#F2F1EF" CornerRadius="9" Padding="11,7" VerticalAlignment="Center"><TextBlock x:Name="SelectedDevicesText" Text="CPU · ONNX Runtime" FontSize="10" FontWeight="SemiBold" Foreground="#595855"/></Border></Grid>
                <Border Background="#FAF9F7" BorderBrush="#EBEAE7" BorderThickness="1" CornerRadius="9" Padding="10,8" Margin="0,14,0,0"><TextBlock x:Name="SelectedDatasetSummary" Text="Dataset: selected test folder" FontSize="11" Foreground="#5E5C57" TextTrimming="CharacterEllipsis" ToolTip="Selected dataset folder"/></Border>
                <ProgressBar x:Name="BenchmarkProgressBar" Height="6" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" Foreground="{StaticResource AccentBrush}" Background="#E8E7E5" BorderThickness="0" Margin="0,16,0,0"/>
                <TextBlock x:Name="BenchmarkStatusText" Text="Inference timing excludes image processing and report generation." FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,0" TextWrapping="Wrap"/>
                <Grid x:Name="ProgressTelemetryPanel" Visibility="Collapsed" Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,9,11"><TextBlock Text="CPU UTILIZATION" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><Grid Margin="0,3,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="CpuUsageText" Text="—" FontSize="14" FontWeight="SemiBold"/><Polyline x:Name="CpuSparkline" Grid.Column="1" Height="25" Width="100" Stroke="#4B4A47" StrokeThickness="1.7" Stretch="Fill" HorizontalAlignment="Right"/></Grid></StackPanel>
                  <StackPanel Grid.Column="1" Grid.Row="0" Margin="9,0,0,11"><TextBlock Text="GPU UTILIZATION" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><Grid Margin="0,3,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="GpuUsageText" Text="—" FontSize="14" FontWeight="SemiBold"/><Polyline x:Name="GpuSparkline" Grid.Column="1" Height="25" Width="100" Stroke="#8B8985" StrokeThickness="1.7" Stretch="Fill" HorizontalAlignment="Right"/></Grid></StackPanel>
                  <StackPanel Grid.Column="0" Grid.Row="1"><TextBlock Text="ACTIVE MEMORY" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="ActiveMemoryText" Text="—" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
                  <StackPanel Grid.Column="1" Grid.Row="1" Margin="9,0,0,0"><TextBlock Text="ACTIVE DEVICE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="DeviceActiveText" Text="CPU · ONNX Runtime" FontSize="12" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                </Grid>
                <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Button x:Name="RunButton" Style="{StaticResource PrimaryButton}" Click="RunBenchmark_Click" IsEnabled="False" HorizontalAlignment="Stretch"><StackPanel Orientation="Horizontal"><Viewbox Width="14" Height="14" Margin="0,0,8,0"><Path Data="{StaticResource OcticonPlay}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Viewbox><TextBlock Text="Run benchmark"/></StackPanel></Button>
                  <Button x:Name="CancelButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Height="46" Margin="9,0,0,0" Click="CancelBenchmark_Click" Visibility="Collapsed" Content="Cancel"/>
                </Grid>
              </StackPanel>
            </Border>
            <Border x:Name="ResultsCard" Background="#FFFFFF" BorderBrush="#E5E4E1" BorderThickness="1" CornerRadius="17" Padding="19" Visibility="Collapsed">
              <StackPanel>
                <TextBlock Text="Benchmark result" FontSize="18" FontWeight="SemiBold"/>
                <Grid Margin="0,13,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ACCURACY" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="AccuracyResultText" Text="—" FontSize="23" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="THROUGHPUT" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="ThroughputResultText" Text="—" FontSize="23" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Grid>
                <TextBlock x:Name="ResultDetailText" Text="Latency percentiles and image counts appear after a run." FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,9"/>
                <Grid x:Name="ComparisonTable" Visibility="Collapsed" Margin="0,7,0,9"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Grid.Row="0" Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions><TextBlock Text="DEVICE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock Grid.Column="1" Text="FPS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock Grid.Column="2" Text="ACCURACY" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock Grid.Column="3" Text="P99 FRAME" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock Grid.Column="4" Text="WORST FRAME" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/></Grid><ItemsControl x:Name="ComparisonRunsList" Grid.Row="1"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Device}" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding ThroughputDisplay}" FontSize="10"/><TextBlock Grid.Column="2" Text="{Binding AccuracyDisplay}" FontSize="10"/><TextBlock Grid.Column="3" Text="{Binding P99LatencyDisplay}" FontSize="10"/><TextBlock Grid.Column="4" Text="{Binding MaxLatencyDisplay}" FontSize="10"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid>
                <Border x:Name="ReportReadyPanel" Background="#F7F6F4" BorderBrush="#E8E7E5" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,8,0,0" Visibility="Collapsed">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <local:AndGateMascot x:Name="ReportMascot" Width="50" Height="50" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0"><TextBlock x:Name="ReportReadyCaption" Text="Benchmark complete — report generated." FontSize="12" FontWeight="SemiBold"/><TextBlock Text="Your HTML report is ready to open." FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel>
                    <Button x:Name="OpenReportButton" Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Open HTML report" Click="OpenReport_Click" IsEnabled="False" VerticalAlignment="Center" ToolTip="Open the latest HTML benchmark report" AutomationProperties.Name="Open latest HTML benchmark report"/>
                  </Grid>
                </Border>
                <TextBlock x:Name="ReportPathText" Text="" FontSize="9" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="2,7,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E5E4E1" BorderThickness="1" CornerRadius="17" Padding="19" Margin="10,0,0,0">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Frame latency" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Batch size 1 · per-image wall-clock samples" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel><Border Grid.Column="1" Background="#F5F4F2" CornerRadius="8" Padding="9,6" VerticalAlignment="Top"><TextBlock Text="LIVE TRACE" FontSize="9" FontWeight="Bold" Foreground="#5E5C57"/></Border></Grid>
            <Border Grid.Row="1" Background="#FCFBFA" BorderBrush="#EFEEEC" BorderThickness="1" CornerRadius="10" Margin="0,14,0,10" Padding="8">
              <local:LatencyChartControl x:Name="LatencyChart" MinHeight="300" MinWidth="360"/>
            </Border>
            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="P50" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="LatencyP50Text" Text="—" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="P95" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="LatencyP95Text" Text="—" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="P99" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="LatencyP99Text" Text="—" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="WORST" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="LatencyMaxText" Text="—" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel></Grid>
          </Grid>
        </Border>
      </Grid>

      <Border Grid.Row="2" Background="#FAF9F7" BorderBrush="#E8E7E5" BorderThickness="1" CornerRadius="14" Padding="14,9" Margin="0,12,0,0">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Canvas x:Name="MascotStage" Width="148" Height="62" ClipToBounds="False" VerticalAlignment="Center" IsHitTestVisible="False"><local:AndGateMascot x:Name="RunnerSprite" Width="54" Height="54" Canvas.Left="0" Canvas.Top="0"/></Canvas>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"><TextBlock Text="THROUGHPUT" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="RunnerFpsText" Text="— FPS" FontSize="20" FontWeight="SemiBold" Margin="0,2,0,0"/><TextBlock Text="Measured model calls per second" FontSize="10" Foreground="{StaticResource MutedBrush}"/></StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0"><TextBlock Text="COMPUTE RATE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="GopsText" Text="— GOPS" FontSize="20" FontWeight="SemiBold" Margin="0,2,0,0"/><TextBlock Text="Estimated operations per second" FontSize="10" Foreground="{StaticResource MutedBrush}"/></StackPanel>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="1" Background="#FAF9F7" BorderBrush="#E8E7E5" BorderThickness="0,1,0,0">
      <Grid Margin="22,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="PROJECT-AGENTGATE-V" FontSize="9" FontWeight="Bold" Foreground="#92918E" VerticalAlignment="Center"/><TextBlock x:Name="FooterStatus" Grid.Column="1" Text="Checking this PC…" FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/></Grid>
    </Border>

    <Grid x:Name="TransitionView" Grid.RowSpan="2" Panel.ZIndex="20" Background="#F7F6F4" Visibility="Visible">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="390">
        <local:AndGateMascot x:Name="TransitionMascot" Width="88" Height="88" HorizontalAlignment="Center"/>
        <TextBlock x:Name="TransitionTitle" Text="Checking this PC" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0"/>
        <TextBlock x:Name="TransitionDescription" Text="Finding available processors and graphics devices." FontSize="13" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="12,8,12,18"/>
        <ProgressBar Height="4" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}" Background="#E3E2E0" BorderThickness="0"/>
        <TextBlock x:Name="TransitionStatus" Text="Reading hardware details" FontSize="11" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
        <Button x:Name="TransitionCancelButton" Style="{StaticResource SecondaryButton}" Content="Cancel benchmark" Click="CancelBenchmark_Click" HorizontalAlignment="Center" Margin="0,22,0,0" Visibility="Collapsed"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
