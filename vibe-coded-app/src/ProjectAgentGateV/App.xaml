<Application x:Class="ProjectAgentGateV.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <Color x:Key="Ink">#252525</Color>
    <Color x:Key="Muted">#737373</Color>
    <Color x:Key="Accent">#303030</Color>
    <Color x:Key="AccentDark">#171717</Color>
    <Color x:Key="Line">#E6E5E3</Color>
    <Color x:Key="Canvas">#F5F5F3</Color>
